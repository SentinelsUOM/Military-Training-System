# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# MongoDB connection string (get the rotated one from the team lead — do NOT paste it in git).
MONGODB_URI=mongodb://<user>:<password>@<host>:<port>/<db>

# Base URL the server components use to call their own API routes.
# Local dev: http://localhost:3000
# Production: your deployed URL, e.g. https://sentinels-aar.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
